      <position>0</position>
      <parents>
        <grouped>pf-projection-line-3-grid</grouped>
      </parents>
    </annotation>
    <annotation id="pf-projection-line-3-L" speech2="The line L">
      <active>pf-projection-line-3-L</active>
      <position>2</position>
      <parents>
        <grouped>pf-projection-line-3-figure</grouped>
      </parents>
    </annotation>
    <annotation id="pf-projection-line-3-b" speech2="The vector b is not on the line">
      <active>pf-projection-line-3-b</active>

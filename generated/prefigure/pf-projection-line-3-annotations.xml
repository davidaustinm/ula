<diagram>
  <annotations>
    <annotation id="pf-projection-line-3-figure" speech2="If b hat is the vector on the line L that is closest to the vector b, then b minus b hat should be perpendicular to L">
      <grouped>pf-projection-line-3-figure</grouped>
      <position>1</position>
      <children>
        <active>pf-projection-line-3-grid</active>
        <active>pf-projection-line-3-L</active>
        <active>pf-projection-line-3-b</active>
        <active>pf-projection-line-3-bhat</active>
        <active>pf-projection-line-3-bperp</active>
        <active>pf-projection-line-3-y</active>
      </children>
      <components>
        <active>pf-projection-line-3-grid</active>
        <active>pf-projection-line-3-L</active>
        <active>pf-projection-line-3-b</active>
        <active>pf-projection-line-3-bhat</active>
        <active>pf-projection-line-3-bperp</active>
        <active>pf-projection-line-3-y</active>
      </components>
    </annotation>
    <annotation id="pf-projection-line-3-grid" speech2="The coordinate grid and axes">

<?xml version="1.0" encoding="utf-8"?>
<!--
    This file provides the overall configuration for your PreTeXt
    project. To edit the content of your document, open `source/main.ptx`
    (default location).
-->
<project
    ptx-version="2"
    source="src"
    publication="publication"
    output-dir="output"
    site="site"
    stage="output/stage"
    xsl="xsl"
    >
  <targets>
    <target
        name="html"
        format="html"
        source="ula.xml"
        publication="publication.ptx"
        output-dir="html"
        deploy-dir="."
        xsl="html.xsl"
        />
    <target
        name="pdf"
        format="pdf"
        source="ula.xml"
        publication="publication-print.ptx"
        output-dir="pdf"
        xsl="latex.xsl"
        />
    <target
        name="latex"
        format="latex"
        source="ula.xml"
        publication="publication-print.ptx"
        output-dir="latex"
        xsl="latex.xsl"
        />
    <target
        name="runestone"
        format="html"
        source="ula.xml"
        publication="runestone.ptx"
        xsl="html.xsl"
        output-dir="published/ula"
        />
    <target
        name="proteus"
        format="html"
        source="ula.xml"
        publication="runestone-proteus.ptx"
        xsl="html.xsl"
        output-dir="published/ula-proteus"
        />
    <target
        name="proteus-dev"
        format="html"
        source="ula.xml"
        publication="runestone-proteus-dev.ptx"
        xsl="html.xsl"
        output-dir="published/ula-proteus-dev"
        />
    <target
        name="proteus-playground"
        format="html"
        source="ula.xml"
        publication="runestone-proteus-playground.ptx"
        xsl="html.xsl"
        output-dir="published/ula-proteus-playground"
        />
    <target
        name="proteus-playground-dev"
        format="html"
        source="ula.xml"
        publication="runestone-proteus-playground-dev.ptx"
        xsl="html.xsl"
        output-dir="published/ula-proteus-playground-dev"
        />
    <target
        name="solutions-pdf" 
        format="pdf"
        source="solution-manual.xml"
        publication="publication-solutions.ptx"
        output-dir="solutions-pdf"
        latex-engine="xelatex"
        xsl="solution-manual.xsl" />

    <target
      name="workbook"
      format="pdf"
      source="activity-workbook.xml" 
      publication="publication-workbook.ptx"
      latex-engine="xelatex"
      output-dir="workbook-pdf"
      xsl="activity-workbook.xsl" />
    
    <target
      name="workbook-solutions"
      format="pdf"
      source="activity-workbook.xml" 
      publication="publication-workbook-solutions.ptx"
      latex-engine="xelatex"
      output-dir="workbook-solutions"
      xsl="activity-workbook-solutions.xsl" />
    
  </targets>
</project>

